# Local API bound to 127.0.0.1
ACE_PORT=8787
# Optional: durable debate session directory (default .ace-data/debates)
# ACE_DATA_DIR=./.ace-data/debates

# M4: explicit token (>=24 chars). If unset a secure random token file is created.
# ACE_API_TOKEN=replace-with-long-random-value
# ACE_TOKEN_FILE=.ace-data/api-token

# Durable UTC-day provider call quotas. Omit for unlimited (but metered) calls.
# ACE_DAILY_CALL_LIMIT=100
# ACE_CODEX_DAILY_CALL_LIMIT=50
# ACE_CLAUDE_DAILY_CALL_LIMIT=50
# ACE_GEMINI_DAILY_CALL_LIMIT=50
